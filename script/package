set -e

echo "----------------------------"
echo "--- package | vsuBP ---"
echo "----------------------------"

ROOT_DIR=$(pwd)
BUILD_DIR=$ROOT_DIR/build
PACKAGE_DIR=$ROOT_DIR/packages

mkdir -p "$PACKAGE_DIR"

cd "$BUILD_DIR"

# Build distribution package (.deb, .rpm, or .tar.xz)
make package || cmake --build . --target package

# Build source tarball
make package_source || cmake --build . --target package_source

# Ensure all packages are copied to packages/
for f in *.deb *.rpm *.srpm *.tar.* *.zip; do
    if [ -f "$f" ]; then
        echo "Copying $f to $PACKAGE_DIR"
        cp "$f" "$PACKAGE_DIR/"
    fi
done

cd "$ROOT_DIR"
