set -e

echo "--------------------------"
echo "--- build | vsuBP ---"
echo "--------------------------"

ROOT_DIR=$(pwd)
BUILD_DIR=$ROOT_DIR/build
SRC_DIR=$ROOT_DIR

mkdir -pv "$BUILD_DIR" && cd "$BUILD_DIR"

cmake "$@" "$SRC_DIR"

cmake --build "$BUILD_DIR"

cd "$ROOT_DIR"
