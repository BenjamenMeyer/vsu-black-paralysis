set -e

VS_LOCAL_SHARE_DIR="/usr/local/share/black-paralysis"
VS_SHARE_DIR="/usr/share/black-paralysis"

DATA_DIR=""
if [ -n "${VS_DATA_DIR}" ] && [ -d "${VS_DATA_DIR}" ]; then
    DATA_DIR="${VS_DATA_DIR}"
elif [ -d "./sectors" ] && [ -f "./Version.txt" ]; then
    DATA_DIR="$(pwd)"
elif [ -d "${VS_LOCAL_SHARE_DIR}" ]; then
    DATA_DIR="${VS_LOCAL_SHARE_DIR}"
elif [ -d "${VS_SHARE_DIR}" ]; then
    DATA_DIR="${VS_SHARE_DIR}"
else
    echo "Error: Unable to locate Black Paralysis game asset directory."
    echo "Please install game assets or set the VS_DATA_DIR environment variable."
    exit 1
fi

ENGINE_BIN="vegastrike-engine"
if [ -n "${VS_ENGINE_BIN}" ] && [ -x "${VS_ENGINE_BIN}" ]; then
    ENGINE_BIN="${VS_ENGINE_BIN}"
elif [ -n "${VS_ENGINE_PATH}" ] && [ -x "${VS_ENGINE_PATH}/vegastrike-engine" ]; then
    ENGINE_BIN="${VS_ENGINE_PATH}/vegastrike-engine"
elif command -v vegastrike-engine >/dev/null 2>&1; then
    ENGINE_BIN="vegastrike-engine"
elif [ -x "/usr/local/bin/vegastrike-engine" ]; then
    ENGINE_BIN="/usr/local/bin/vegastrike-engine"
elif [ -x "/usr/bin/vegastrike-engine" ]; then
    ENGINE_BIN="/usr/bin/vegastrike-engine"
fi

echo "Starting Vega Strike Universe: Black Paralysis from: ${DATA_DIR}"
exec "${ENGINE_BIN}" -D "${DATA_DIR}" "$@"
